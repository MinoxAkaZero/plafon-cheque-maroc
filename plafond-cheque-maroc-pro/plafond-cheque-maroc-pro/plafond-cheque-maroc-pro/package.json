{
  "name": "plafond-cheque-maroc-pro",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Système professionnel de gestion des chèques, LCN et plafonds journaliers au Maroc (iOS iPhone/iPad, Android APK, PWA & Desktop)",
  "scripts": {
    "test": "node tests/engine.test.mjs",
    "cap:init": "npx cap init \"PlafondChèque Maroc Pro\" ma.plafondcheque.pro --web-dir public",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0"
  }
}
