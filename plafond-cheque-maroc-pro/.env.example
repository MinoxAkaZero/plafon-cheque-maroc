# PlafondChèque Maroc Pro (v12.5.1) — Supabase Cloud Backend Configuration Example
# Copy your Supabase Project URL and Public Publishable Anon Key into public/cloud-config.js.
# NEVER place SUPABASE_SERVICE_ROLE_KEY in frontend code or commit real secrets to Git!

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY

# Server-side ONLY (configured in Supabase Dashboard -> Edge Functions -> Secrets):
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
